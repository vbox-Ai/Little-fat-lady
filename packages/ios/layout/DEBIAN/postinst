#!/bin/sh
# DSHPet postinst
#
# 规矩：这里绝对不 respring / 不 killall SpringBoard。
# 之前有一版在这里杀桌面，dpkg 事务被打断 → 包停在 half-configured，
# 之后每次收尾都重跑 dpkg 保存的旧 postinst 副本，形成"一开 Sileo 就注销"的死循环。
# 需要生效时由用户自己在 Sileo 里点"重启 SpringBoard"。
set -u

JBROOT=""
[ -d /var/jb ] && JBROOT="/var/jb"

PKG_ASSETS="$JBROOT/Library/Application Support/DSHPet"
RUN_DIR="/var/mobile/Library/DSHPet"
RUN_ASSETS="$RUN_DIR/assets"

mkdir -p "$RUN_DIR" "$RUN_ASSETS" "$RUN_DIR/config" "$RUN_DIR/logs" 2>/dev/null || true
chown -R mobile:mobile "$RUN_DIR" 2>/dev/null || true
chmod 755 "$RUN_DIR" "$RUN_ASSETS" "$RUN_DIR/config" "$RUN_DIR/logs" 2>/dev/null || true

# 素材铺设规则：
#  1) 用户自己放了 main.mov / main.mp4（或已下载过素材包）→ 一概不碰；
#  2) 否则把包内素材整棵铺过去：分桶目录（idle/ turn/ click/ …）+ 平铺演示片。
if [ ! -e "$RUN_ASSETS/main.mov" ] && [ ! -e "$RUN_ASSETS/main.mp4" ] && [ ! -e "$RUN_ASSETS/manifest.json" ]; then
  # 先铺分桶素材（真素材），再决定要不要铺平铺演示片。
  BUCKET_COPIED=0
  for b in idle turn click drag sleep balance workstatus whisper eat play; do
    SRC="$PKG_ASSETS/$b"
    DST="$RUN_ASSETS/$b"
    if [ -d "$SRC" ]; then
      mkdir -p "$DST" 2>/dev/null || true
      if cp -f "$SRC"/*.mov "$DST"/ 2>/dev/null; then BUCKET_COPIED=1; fi
    fi
  done
  # 有真素材就不再铺演示片：两者同类别会互相抢抽签（0.1.0-52 蓝水母现象）。
  if [ "$BUCKET_COPIED" = "0" ]; then
    for f in idle turn click drag sleep; do
      SRC="$PKG_ASSETS/$f.mov"
      DST="$RUN_ASSETS/$f.mov"
      if [ -f "$SRC" ] && [ ! -e "$DST" ]; then
        cp -f "$SRC" "$DST" 2>/dev/null || true
      fi
    done
  fi
  # 旧包装留下的平铺演示片要清掉，否则仍会和真素材抢抽签。
  if [ "$BUCKET_COPIED" = "1" ]; then
    rm -f "$RUN_ASSETS/idle.mov" "$RUN_ASSETS/turn.mov" "$RUN_ASSETS/click.mov" \
          "$RUN_ASSETS/drag.mov" "$RUN_ASSETS/sleep.mov" "$RUN_ASSETS/demo.mov" 2>/dev/null || true
  fi
  if [ -f "$PKG_ASSETS/manifest.json" ] && [ ! -e "$RUN_ASSETS/manifest.json" ]; then
    cp -f "$PKG_ASSETS/manifest.json" "$RUN_ASSETS/manifest.json" 2>/dev/null || true
  fi
fi

chown -R mobile:mobile "$RUN_ASSETS" 2>/dev/null || true
find "$RUN_ASSETS" -type d -exec chmod 755 {} \; 2>/dev/null || true
find "$RUN_ASSETS" -type f -exec chmod 644 {} \; 2>/dev/null || true

echo "小肥娘已安装：在 Sileo 里点“重启 SpringBoard”后生效。"
exit 0
