#!/bin/sh
# DSHPet postinst
#
# 规矩：这里绝对不 respring / 不 killall SpringBoard。
# 之前有一版在这里杀桌面，dpkg 事务被打断 → 包停在 half-configured，
# 之后每次收尾都重跑 dpkg 保存的旧 postinst 副本，形成"一开 Sileo 就注销"的死循环。
# 需要生效时由用户自己在 Sileo 里点"重启 SpringBoard"。
set -u

JBROOT=""
[ -d /var/jb ] && JBROOT="/var/jb"

PKG_ASSETS="$JBROOT/Library/Application Support/DSHPet"
RUN_DIR="/var/mobile/Library/DSHPet"
RUN_ASSETS="$RUN_DIR/assets"

mkdir -p "$RUN_DIR" "$RUN_ASSETS" "$RUN_DIR/config" "$RUN_DIR/logs" 2>/dev/null || true
chown -R mobile:mobile "$RUN_DIR" 2>/dev/null || true
chmod 755 "$RUN_DIR" "$RUN_ASSETS" "$RUN_DIR/config" "$RUN_DIR/logs" 2>/dev/null || true

# 只在用户没有真素材（main.mov / main.mp4）时铺演示片，绝不覆盖用户自己的文件。
if [ ! -e "$RUN_ASSETS/main.mov" ] && [ ! -e "$RUN_ASSETS/main.mp4" ]; then
  for f in idle turn click drag sleep; do
    SRC="$PKG_ASSETS/$f.mov"
    DST="$RUN_ASSETS/$f.mov"
    if [ -f "$SRC" ] && [ ! -e "$DST" ]; then
      cp -f "$SRC" "$DST" 2>/dev/null || true
      chown mobile:mobile "$DST" 2>/dev/null || true
      chmod 644 "$DST" 2>/dev/null || true
    fi
  done
fi

echo "小肥娘已安装：在 Sileo 里点“重启 SpringBoard”后生效。"
exit 0
